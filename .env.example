# Session signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Production only (Turso hosted database). Leave empty in local dev to use
# the local rolltrack.db file instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email, for confirming addresses and resetting passwords, over Brevo's SMTP
# relay. Leave SMTP_KEY empty and accounts are created already confirmed, so
# local development needs no email provider at all.
#
# Brevo needs a verified SENDER, not a domain: Senders, Domains & Dedicated
# IPs -> Senders tab -> Add a sender -> confirm the code it emails you.
SMTP_USER=
SMTP_KEY=
# Must match an address verified as a sender in Brevo.
EMAIL_FROM=
EMAIL_FROM_NAME=Rolltrack
# Where links in emails point. Vercel supplies its own URL if unset.
APP_URL=

# Sign in with Google. Optional: leave empty and the button never appears.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorised redirect URI must be, exactly:
#   https://your-app.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (for local work)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
